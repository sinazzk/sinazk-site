# Never show folder listings
Options -Indexes

# Unknown URLs show the custom 404 page
ErrorDocument 404 /404.html

# Canonicalize explicit index URLs without redirecting Apache's internal index lookup.
RewriteEngine On
RewriteCond %{THE_REQUEST} "\s/+[^?\s]*index\.html[?\s]"
RewriteRule ^(.*)index\.html$ https://sinazk.com/$1 [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.sinazk\.com$ [NC]
RewriteRule ^ https://sinazk.com%{REQUEST_URI} [R=301,L]

# Route CV link clicks through the site before opening Google Drive.
RedirectMatch 302 ^/cv/?$ https://drive.google.com/file/d/1TX_gvWSUKH6xAQ0qkMHym0XR-vtFZKS3/view?usp=sharing
